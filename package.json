{
  "name": "malgn-costdown",
  "version": "1.0.0",
  "description": "맑은 비용절감 — 정적 페이지 + 비용 편집값 저장 API (Cloudflare Pages + D1)",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "wrangler pages dev",
    "deploy": "wrangler pages deploy",
    "db:create": "wrangler d1 create malgn-costdown-edits",
    "db:migrate:local": "wrangler d1 execute malgn-costdown-edits --local --file=migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute malgn-costdown-edits --remote --file=migrations/0001_init.sql",
    "db:export:remote": "wrangler d1 export malgn-costdown-edits --remote --output=db/d1-dump.sql"
  },
  "dependencies": {
    "express": "^4.21.1"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
